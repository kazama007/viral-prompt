{
  "version": 2,
  "routes": [
    {
      "src": "^/index(?:\\.(?:php|html))?$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/logout(?:\\.php)?$",
      "status": 302,
      "headers": {
        "Location": "/login?logout=1"
      }
    },
    {
      "src": "^/(.+)\\.(?:php|html)$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "^/(.*)\\.(?:ico|jpg|jpeg|png|gif|svg|webp|css|js|woff|woff2)$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
