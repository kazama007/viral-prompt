{
  "version": 2,
  "routes": [
    {
      "src": "^/index(?:\\.(?:php|html))?$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/logout(?:\\.php)?$",
      "status": 302,
      "headers": {
        "Location": "/login?logout=1"
      }
    },
    {
      "src": "^/(.+)\\.(?:php|html)$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
